# ==============================================================================
# AI Tutor - Environment Configuration Template
# Copy this file to .env and fill in your API credentials.
# ==============================================================================

# LiveKit WebRTC Configuration
# For local development with main.py:
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For LiveKit Cloud deployments:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=your_cloud_api_key
# LIVEKIT_API_SECRET=your_cloud_api_secret

# Google Gemini API Key (Required for Voice Agent & Gemini Live Realtime Model)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

